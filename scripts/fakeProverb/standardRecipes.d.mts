/**
 * `markdownPath`, `generatedPath` and `lockPath` override the files this
 * module would otherwise derive from `rootDir`. They exist so a test can
 * exercise a stale or malformed module in a temporary directory instead of
 * editing the checkout. `lockPath` is required whenever `generatedPath` is a
 * temporary file, so a version bump cannot rewrite the tracked lock. They
 * cannot make a comparison vacuous: the document is still the only source the
 * generated text and lock digest are derived from, and the lock is the
 * authority for same-version meaning changes.
 */
export type FakeProverbRecipePathOptions = {
	rootDir?: string;
	markdownPath?: string;
	generatedPath?: string;
	lockPath?: string;
};

export declare function generateStandardFakeProverbRecipes(
	options?: FakeProverbRecipePathOptions & { markdown?: string },
): Promise<{
	parsed: ParsedFakeProverbRecipeDocument;
	compiled: CompiledFakeProverbRecipeSet;
	source: string;
}>;

export declare function assertStandardFakeProverbRecipesGenerated(
	options?: FakeProverbRecipePathOptions & {
		markdown?: string;
		/**
		 * Test hook that replaces destination reads of the generated module and
		 * lock. Production never supplies this. Absence is only ENOENT; every
		 * other read failure is reported as unreadable.
		 */
		readText?: (filePath: string) => Promise<string>;
	},
): Promise<{ schemaVersion: number; dataVersion: number }>;

