export type FakeProverbRecipeGuardBuild = {
	/** Only `tsconfig` is read; the guard refuses to start unless it names a file. */
	initialOptions?: { tsconfig?: string };
	onStart: (
		callback: () => Promise<{
			errors?: { text: string; detail?: unknown }[];
		} | null>,
	) => void;
	onLoad: (
		options: { filter: RegExp },
		callback: (args: { path: string }) => Promise<{ contents: string; loader: "ts"; watchFiles: string[] } | null>,
	) => void;
	onResolve: (
		options: { filter: RegExp },
		callback: (args: { path: string; kind: string; resolveDir: string }) => { path: string; watchFiles: string[] } | null,
	) => void;
};

