	onLoad: (
		options: { filter: RegExp },
		callback: (args: { path: string }) => Promise<{ contents: string; loader: "ts"; watchFiles: string[] } | null>,
	) => void;
};

/** The esbuild plugin that repeats the check when every build and rebuild starts. */
export declare function standardFakeAlertRecipesPlugin(
	rootDir: string,
	options?: { readText?: (filePath: string) => Promise<string> },
): {
	name: string;
	setup: (build: FakeAlertRecipeGuardBuild) => void;
};

export declare function writeStandardFakeAlertRecipes(
	options?: FakeAlertRecipePathOptions & {
		markdown?: string;
		/** Test hook invoked immediately before each destination rename. */
		beforePublish?: (phase: "generated" | "lock") => void | Promise<void>;
		/** Test hook invoked immediately before restoring or removing generated bytes. */
		beforeRollback?: () => void | Promise<void>;
		/** Test hook invoked after rollback staging is written, before it is renamed. */
		beforeRollbackRename?: (stagingPath: string, destination: string) => void | Promise<void>;
		/** Test hook invoked immediately before removing a staging file. */
		beforeCleanup?: (filePath: string) => void | Promise<void>;
		/**
		 * Test hook that replaces destination reads of the generated module and
		 * lock. Production never supplies this. Absence is only ENOENT; every
		 * other read failure propagates before staging or publication.
		 */
		readText?: (filePath: string) => Promise<string>;
	},
): Promise<{
	outfile: string;
	schemaVersion: number;
	dataVersion: number;
	families: number;
	prompts: number;
	terminals: number;
	outcomes: number;
}>;
